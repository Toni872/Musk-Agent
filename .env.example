# MUSK simulation harness — optional LLM provider.
#
# The FastAPI app loads this file when it exists (see `app/main.py`). The key is
# used server-side only; it never reaches the browser.
#
# Copy this file to `.env` (git-ignored) and fill in the key:
#
#     Copy-Item .env.example .env
#
# `uv run uvicorn app.main:app --port 4173` loads `.env` when it exists.
# Variables already exported in your shell win over the file, so you can
# override a single value per run.
#
# Without BOTH MUSK_LLM_BASE_URL and MUSK_LLM_API_KEY the harness stays fully
# deterministic: approved replies only, no network, no key. That is the default
# and the state the automated tests run in.
#
# The endpoint must be HTTPS. The client appends `/chat/completions`, so the
# base URL already includes the version segment (`.../v1`).
#
# ---------------------------------------------------------------------------
# Groq: OpenAI-compatible, so no code change is needed.
# Model choice (July 2026 GROQ catalog):
#   openai/gpt-oss-120b -> strongest, ~$0.15/$0.60 per 1M tokens
#   openai/gpt-oss-20b  -> cheaper and faster, ~$0.075/$0.30 per 1M tokens
# Do NOT use llama-3.3-70b-versatile or llama-3.1-8b-instant: deprecated by
# Groq on 2026-08-16.
# ---------------------------------------------------------------------------
MUSK_LLM_BASE_URL=https://api.groq.com/openai/v1
MUSK_LLM_API_KEY=
MUSK_LLM_MODEL=openai/gpt-oss-120b
MUSK_LLM_TEMPERATURE=0.2

# Reliability: retries with capped exponential backoff for transient failures
# (timeout, connection error, 429, 5xx). Definitive 4xx responses are never
# retried. Total tries = 1 + MUSK_LLM_MAX_RETRIES.
MUSK_LLM_MAX_RETRIES=2
MUSK_LLM_BACKOFF_BASE_SECONDS=0.5
MUSK_LLM_BACKOFF_MAX_SECONDS=4.0

# Optional cost tracing (USD per 1M tokens) shown in the supervision panel and
# the `llm_call` log line. Leave blank to trace tokens/latency without a cost.
# Example for openai/gpt-oss-120b: 0.15 and 0.60.
MUSK_LLM_PRICE_INPUT_PER_1M=
MUSK_LLM_PRICE_OUTPUT_PER_1M=

# --- Public deployment (docker compose) -------------------------------------
# Hostname Caddy obtains a TLS certificate for. It must resolve to this host
# with ports 80 and 443 open. Only needed for `docker compose up`.
MUSK_DOMAIN=
# Single shared credential protecting the UI and the API. Both values are
# required to enable it; leave both blank for local simulation. /health stays
# public so the container healthcheck works without credentials.
MUSK_BASIC_AUTH_USER=
MUSK_BASIC_AUTH_PASSWORD=

