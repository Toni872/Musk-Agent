# TLS is terminated here. Caddy provisions and renews the certificate for
# MUSK_DOMAIN automatically, which requires the domain to resolve to this host
# and ports 80/443 to be reachable. Authentication is enforced by the app, so
# Caddy only proxies and adds the security headers below.
{$MUSK_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	reverse_proxy app:8000
}
