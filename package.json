{
  "name": "musk-simulation",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Standalone simulation harness for the MUSK MVP conversational agent (no real channel, no real leads, no CRM).",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/simulator.ts",
    "eval": "tsx src/eval.ts",
    "build:api": "node scripts/build-api.mjs",
    "build:ui": "node ui/build.mjs",
    "pilot-gate": "tsx scripts/pilot-gate.ts",
    "deploy": "npm run pilot-gate && vercel deploy --prod",
    "ui": "node ui/build.mjs && tsx ui/dev-server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
